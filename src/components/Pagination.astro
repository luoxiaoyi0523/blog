---
import { withBase } from '../utils/path';

interface Props {
  currentPage: number;
  totalPages: number;
}
const { currentPage, totalPages } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const prevHref =
  currentPage > 1 ? (currentPage === 2 ? withBase('/') : withBase(`page/${currentPage - 1}`)) : null;
const nextHref = currentPage < totalPages ? withBase(`page/${currentPage + 1}`) : null;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页">
    {prevHref
      ? <a href={prevHref}>← 上一页</a>
      : <span class="disabled">← 上一页</span>}
    {pages.map((n) => (
      <a
        href={n === 1 ? withBase('/') : withBase(`page/${n}`)}
        class={n === currentPage ? 'current' : ''}
        aria-current={n === currentPage ? 'page' : undefined}
      >{n}</a>
    ))}
    {nextHref
      ? <a href={nextHref}>下一页 →</a>
      : <span class="disabled">下一页 →</span>}
  </nav>
)}
