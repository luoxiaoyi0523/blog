---
interface Props {
  category?: string;
  tags?: string[];
}
const { category, tags = [] } = Astro.props;
---

{category && (
  <a class="badge cat" href={`/categories/${encodeURIComponent(category)}`}>{category}</a>
)}
{tags.map((t) => (
  <a class="badge" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>
))}
