---
import { SITE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <span>© {year} {SITE.author} · {SITE.title}</span>
    <span class="social">
      {SOCIAL.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </span>
  </div>
</footer>
