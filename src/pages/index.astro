---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../consts';
import { withBase } from '../utils/path';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageSize = SITE.pageSize;
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
const pagePosts = posts.slice(0, pageSize);
const currentPage = 1;

const QQ_NUMBER = '1707127199';

// 读取摄影文件夹全部图片，构建时转成带 /blog/ 前缀的 URL 数组，
// 客户端每次刷新随机抽几张做成横向滚动卡片流。
// 注意：glob 返回的 meta.src 有时已带 base 前缀，这里先归一化再去重加前缀。
const BASE = import.meta.env.BASE_URL;
function normSrc(src: string): string {
  let s = src;
  if (s.startsWith(BASE)) s = s.slice(BASE.length);
  s = s.replace(/^\/+/, '');
  return BASE + s;
}
const photoModules = import.meta.glob('../assets/photos/*.{jpeg,jpg,png,webp,gif,avif}', {
  eager: true,
});
const allPhotos: string[] = Object.values(photoModules).map(
  (m: any) => normSrc(m.default.src as string)
);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-avatar">
        <img src={withBase('avatar.jpg')} alt="" />
      </div>
      <h1>鱼板的自留地</h1>
      <p class="hero-tag">{SITE.tagline}</p>
      <div class="hero-actions">
        <a class="btn primary" href={withBase('photos/')}>📷 看看摄影</a>
        <button class="btn outline qq-btn" data-qq={QQ_NUMBER} title="点击复制 QQ 号">📮 QQ: {QQ_NUMBER}</button>
        <a class="btn outline" href={withBase('about/')}>关于我 →</a>
      </div>
      <div class="hero-stats">
        <span><strong>{posts.length}</strong> 篇文章</span>
        <span class="sep">·</span>
        <a href={withBase('categories/')}>分类</a>
        <span class="sep">·</span>
        <a href={withBase('photos/')}>摄影</a>
      </div>
    </div>
  </section>

  {
    allPhotos.length > 0 && (
      <section class="photo-marquee" data-photos={JSON.stringify(allPhotos)} aria-label="摄影卡片流">
        <div class="marquee-head">
          <span class="marquee-title">📷 随机拾光</span>
          <span class="marquee-sub">每次刷新，随机几张</span>
        </div>
        <div class="marquee-viewport">
          <div class="marquee-track" id="marqueeTrack"></div>
        </div>
      </section>
    )
  }

  <div class="post-list">
    {pagePosts.map((post) => <PostCard post={post} />)}
  </div>

  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>

<script>
  // ── QQ 号一键复制 ──
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.qq-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const qq = btn.dataset.qq ?? '';
    navigator.clipboard.writeText(qq).then(() => {
      const orig = btn.innerHTML;
      btn.innerHTML = '✅ 已复制！';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = orig;
        btn.classList.remove('copied');
      }, 1800);
    }).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = qq;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      const orig = btn.innerHTML;
      btn.innerHTML = '✅ 已复制！';
      btn.classList.add('copied');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 1800);
    });
  });
  document.querySelectorAll('.qq-btn').forEach((btn) => {
    btn.setAttribute('title', '点击复制 QQ 号');
  });

  // ── 横向随机摄影卡片流（鼠标跟随 3D 倾斜 + 无缝循环） ──
  function buildMarquee() {
    const wrap = document.querySelector<HTMLElement>('.photo-marquee');
    const track = document.getElementById('marqueeTrack');
    if (!wrap || !track) return;
    if (track.dataset.built) return; // 避免 View Transitions 重复构建
    const all: string[] = JSON.parse(wrap.dataset.photos || '[]');
    if (!all.length) return;

    // 洗牌
    const shuffled = [...all];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    // 随机抽 6~9 张（不超过总数），最少保证 4 张
    const count = Math.max(4, Math.min(all.length, 6 + Math.floor(Math.random() * 4)));
    const picked = shuffled.slice(0, count);

    // 复制一份用于无缝循环
    const set = [...picked, ...picked];
    track.innerHTML = set
      .map(
        (src) =>
          `<a class="marquee-card" href="${withBaseSafe('photos/')}"><img src="${src}" alt="摄影作品" loading="lazy" /></a>`
      )
      .join('');
    track.dataset.built = '1';

    // 启动滚动动画
    requestAnimationFrame(() => {
      const w = track.scrollWidth / 2;
      if (w <= 0) return;
      const speed = 65; // px/秒
      const duration = Math.max(16, w / speed);
      track.style.animation = `marquee-scroll ${duration}s linear infinite`;
      track.classList.add('running');
    });

    // ── 鼠标跟随 3D 倾斜效果 ──
    // 每张卡片独立跟踪鼠标位置，鼠标靠近哪边哪边就"低"下去
    track.querySelectorAll<HTMLElement>('.marquee-card').forEach((card) => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;   // 鼠标在卡片内的横坐标
        const y = e.clientY - rect.top;    // 鼠标在卡片内的纵坐标
        const cx = rect.width / 2;         // 卡片中心 X
        const cy = rect.height / 2;        // 卡片中心 Y

        // 归一化到 -1 ~ 1
        const nx = (x - cx) / cx;   // 左负右正
        const ny = (y - cy) / cy;   // 上负下正

        // 倾斜角度：鼠标在哪边，那边就向下/向外偏
        // rotateY: 鼠标在右边 → 卡片右边缘远离（正角度）；左边则反
        // rotateX: 鼠标在下边 → 卡片下边缘远离（负角度）
        const rotY = nx * 14;  // 最大 ±14°
        const rotX = -ny * 10; // 最大 ±10°

        card.style.transform = `perspective(800px) rotateY(${rotY}deg) rotateX(${rotX}deg)`;
        card.style.transition = 'transform 0.12s ease-out';
      });

      card.addEventListener('mouseleave', () => {
        // 回到默认微倾斜
        card.style.transform = 'perspective(800px) rotateY(-4deg) rotateX(2deg)';
        card.style.transition = 'transform 0.45s cubic-bezier(.2,.9,.3,1)';
      });
    });
  }
  function withBaseSafe(p: string): string {
    const base = (document.querySelector('meta[name="base"]') as HTMLMetaElement)?.content || '';
    if (p.startsWith('http') || p.startsWith('//')) return p;
    if (p.startsWith('/')) return base.replace(/\/$/, '') + p;
    return base + p;
  }

  buildMarquee();
  document.addEventListener('astro:page-load', buildMarquee);
</script>
