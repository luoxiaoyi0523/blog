---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../consts';
import { withBase } from '../utils/path';

const posts = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageSize = SITE.pageSize;
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
const pagePosts = posts.slice(0, pageSize);
const currentPage = 1;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg viewBox="0 0 600 300" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#38bdf8" stop-opacity="0.5" />
          <stop offset="1" stop-color="#818cf8" stop-opacity="0.35" />
        </linearGradient>
        <linearGradient id="g2" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#f472b6" stop-opacity="0.45" />
          <stop offset="1" stop-color="#fb923c" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <circle cx="90" cy="60" r="120" fill="url(#g1)" />
      <circle cx="520" cy="240" r="160" fill="url(#g2)" />
      <circle cx="430" cy="40" r="70" fill="url(#g1)" opacity="0.6" />
    </svg>
  </div>
  <div class="hero-inner container">
    <div class="hero-avatar">
      <img src={withBase('favicon.svg')} alt="" />
    </div>
    <h1>{SITE.title}</h1>
    <p class="hero-tag">{SITE.tagline}</p>
    <p class="hero-desc">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn" href={withBase('photos/')}>📷 看看摄影</a>
      <a class="btn ghost" href={withBase('about/')}>关于我 →</a>
    </div>
    <div class="hero-stats">
      <span><strong>{posts.length}</strong> 篇文章</span>
      <span class="sep">·</span>
      <a href={withBase('categories/')}><strong>分类</strong></a>
      <span class="sep">·</span>
      <a href={withBase('photos/')}><strong>摄影</strong></a>
    </div>
  </div>
</section>

<div class="post-list">
  {pagePosts.map((post) => <PostCard post={post} />)}
</div>

<Pagination currentPage={currentPage} totalPages={totalPages} />
