---
import { withBase } from '../utils/path';

interface Props {
  category?: string;
  tags?: string[];
}
const { category, tags = [] } = Astro.props;
---

{category && (
  <a class="badge cat" href={withBase(`categories/${encodeURIComponent(category)}`)}>{category}</a>
)}
{tags.map((t) => (
  <a class="badge" href={withBase(`tags/${encodeURIComponent(t)}`)}>#{t}</a>
))}
