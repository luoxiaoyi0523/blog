---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../consts';
import { withBase } from '../utils/path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';

const posts = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageSize = SITE.pageSize;
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
const pagePosts = posts.slice(0, pageSize);
const currentPage = 1;

// 读取摄影文件夹全部图片，构建时统一转成 440×280 的 webp 缩略图，
// 这样运行时加载的是几十 KB 级的小图，而不是几 MB 的原图——这是解决
// “加载时整个网站都卡”的根本手段。客户端每次刷新再随机抽几张做横向流。
const BASE = import.meta.env.BASE_URL;
function normSrc(src: string): string {
  let s = src;
  if (s.startsWith(BASE)) s = s.slice(BASE.length);
  s = s.replace(/^\/+/, '');
  return BASE + s;
}
const photoModules = import.meta.glob('../assets/photos/*.{jpeg,jpg,png,webp,gif,avif}', {
  eager: true,
});
// 每条记录带 id（文件名去扩展名），供卡片流点击后跳转到摄影页对应照片
const allPhotos: { src: string; id: string }[] = await Promise.all(
  Object.entries(photoModules).map(async ([path, m]: [string, any]) => {
    const id = (path.split('/').pop() ?? '').replace(/\.[^.]+$/, '');
    try {
      const optimized = await getImage({
        src: m.default,
        width: 440,
        height: 280,
        format: 'webp',
        fit: 'cover',
      });
      return { src: normSrc(optimized.src), id };
    } catch {
      // 极少数情况下某张图处理失败，退化用原图，保证不崩
      return { src: normSrc(m.default.src as string), id };
    }
  })
);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-avatar">
        <img src={withBase('avatar.jpg')} alt="" />
      </div>
      <h1>鱼板的自留地</h1>
      <p class="hero-tag quote-wrap" data-quotes='["生活不是等待风暴过去，而是学会在雨中跳舞。", "你不必等到万事俱备才出发，光是你自己就足够了。", "所谓自由，不是随心所欲，而是主宰自己。", "世界很大，书本就是窗户。", "每一个不曾起舞的日子，都是对生命的辜负。", "保持热爱，奔赴山海。", "星光不问赶路人，时光不负有心人。", "愿你历尽千帆，归来仍是少年。", "种一棵树最好的时间是十年前，其次是现在。", "人生没有白走的路，每一步都算数。", "与其向往，不如成为。", "温柔半两，从容一生。"]'>
        <span class="quote-text">记录技术、生活与细碎思绪</span>
        <span class="quote-copy" aria-hidden="true">📋</span>
        <span class="copy-bubble">已复制 ✓</span>
      </p>
      <div class="hero-actions">
        <a class="btn primary" href={withBase('photos/')}>📷 看看摄影</a>
        <a class="btn outline" href={withBase('about/')}>关于我 →</a>
      </div>
    </div>
  </section>

  {
    allPhotos.length > 0 && (
      <section class="photo-marquee" data-photos={JSON.stringify(allPhotos)} aria-label="摄影卡片流">
        <div class="marquee-head">
          <span class="marquee-title">📷 随机拾光</span>
        </div>
        <div class="marquee-viewport">
          <div class="marquee-track" id="marqueeTrack"></div>
        </div>
      </section>
    )
  }

  <div class="post-list">
    {pagePosts.map((post) => <PostCard post={post} />)}
  </div>

  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>

<script>
  // ── 随机语录：每次加载随机选一句，点击复制（气泡提示，不挡文字） ──
  function initQuote() {
    const wrap = document.querySelector<HTMLElement>('.quote-wrap');
    if (!wrap || wrap.dataset.inited) return;
    const raw = wrap.dataset.quotes || '[]';
    let quotes: string[] = [];
    try {
      quotes = JSON.parse(raw);
    } catch (_) {
      return;
    }
    if (!quotes.length) return;

    const textEl = wrap.querySelector<HTMLElement>('.quote-text');
    const bubble = wrap.querySelector<HTMLElement>('.copy-bubble');
    if (!textEl) return;

    // 随机选一句
    textEl.textContent = quotes[Math.floor(Math.random() * quotes.length)];

    const showBubble = () => {
      if (!bubble) return;
      bubble.classList.add('show');
      setTimeout(() => bubble.classList.remove('show'), 1500);
    };

    wrap.addEventListener('click', () => {
      const text = textEl.textContent || '';
      navigator.clipboard.writeText(text).then(showBubble).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showBubble();
      });
    });
    wrap.dataset.inited = '1';
  }
  initQuote();
  document.addEventListener('astro:page-load', initQuote);

  // ── QQ 号一键复制（仅作用于关于页等仍带 .qq-btn 的地方） ──
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.qq-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const qq = btn.dataset.qq ?? '';
    navigator.clipboard.writeText(qq).then(() => {
      const orig = btn.innerHTML;
      btn.innerHTML = '✅ 已复制！';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = orig;
        btn.classList.remove('copied');
      }, 1800);
    }).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = qq;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      const orig = btn.innerHTML;
      btn.innerHTML = '✅ 已复制！';
      btn.classList.add('copied');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 1800);
    });
  });
  document.querySelectorAll('.qq-btn').forEach((btn) => {
    btn.setAttribute('title', '点击复制 QQ 号');
  });

  // ── 横向随机摄影卡片流（可拖拽 / 触摸 / 滚轮 + 惯性 + 鼠标跟随 3D 倾斜） ──
  function buildMarquee() {
    const wrap = document.querySelector<HTMLElement>('.photo-marquee');
    const track = document.getElementById('marqueeTrack');
    const viewport = wrap?.querySelector<HTMLElement>('.marquee-viewport');
    if (!wrap || !track || !viewport) return;
    if (track.dataset.built) return;
    const all: { src: string; id: string }[] = JSON.parse(wrap.dataset.photos || '[]');
    if (!all.length) return;

    // 洗牌
    const shuffled = [...all];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    // 随机抽卡片：照片少就全用，多则抽 6~8 张（控制 DOM 数量，避免卡顿）
    const target = all.length <= 8 ? all.length : 6 + Math.floor(Math.random() * 3);
    const count = Math.max(4, Math.min(all.length, target));
    const picked = shuffled.slice(0, count);
    const unitCount = picked.length;

    const cardHtml = (item: { src: string; id: string }) =>
      `<a class="marquee-card" href="${withBaseSafe('photos/')}#${encodeURIComponent(item.id)}"><img src="${item.src}" alt="摄影作品" loading="eager" decoding="async" fetchpriority="low" draggable="false" /></a>`;

    // 两阶段构建：先放 1 份测宽，再按视口宽度补足份数（封顶 6，避免 DOM 爆炸）
    track.innerHTML = picked.map(cardHtml).join('');
    track.dataset.built = '1';

    requestAnimationFrame(() => {
      const vw = viewport.clientWidth;
      const unitW = track.scrollWidth || unitCount * (220 + 16);
      const needed = Math.min(6, Math.max(2, Math.ceil((vw + unitW) / unitW)));

      let full = '';
      for (let i = 0; i < needed; i++) full += picked.map(cardHtml).join('');
      track.innerHTML = full;

      const cards = track.querySelectorAll<HTMLElement>('.marquee-card');
      // 循环周期 = 第 2 份首卡相对第 1 份首卡的偏移（含 gap，零误差）
      const oneSetWidth = cards.length > unitCount
        ? (cards[unitCount] as HTMLElement).offsetLeft - (cards[0] as HTMLElement).offsetLeft
        : track.scrollWidth;

      // ── 鼠标跟随 3D 倾斜（必须在重建后绑定到新卡片） ──
      cards.forEach((card) => {
        card.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const nx = (e.clientX - rect.left - rect.width / 2) / (rect.width / 2);
          const ny = (e.clientY - rect.top - rect.height / 2) / (rect.height / 2);
          card.style.transform = `perspective(800px) rotateY(${nx * 14}deg) rotateX(${-ny * 10}deg)`;
          card.style.transition = 'transform 0.12s ease-out';
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = `perspective(800px) rotateY(-4deg) rotateX(2deg)`;
          card.style.transition = 'transform 0.45s cubic-bezier(.2,.9,.3,1)';
        });
      });

      // ── 拖拽 / 触摸 / 滚轮 滚动控制器（松手带惯性，无限循环） ──
      let pos = 0;              // 轨道位移（负值=向左）
      let isDown = false;
      let startX = 0, startPos = 0, lastX = 0, lastT = 0, velocity = 0, moved = 0;
      let momentumId = 0;
      let suppressClick = false;

      // 把任意位移折叠到 [-oneSetWidth, 0)，内容重复故视觉无缝
      const wrapPos = (p: number) => {
        if (oneSetWidth <= 0) return p;
        let r = p % oneSetWidth;
        if (r > 0) r -= oneSetWidth;
        return r;
      };
      const apply = () => { track.style.transform = `translate3d(${pos}px,0,0)`; };
      const stopMomentum = () => { if (momentumId) { cancelAnimationFrame(momentumId); momentumId = 0; } };

      const onDown = (e: PointerEvent) => {
        isDown = true;
        stopMomentum();
        startX = e.clientX; startPos = pos; lastX = e.clientX; lastT = performance.now();
        velocity = 0; moved = 0;
        viewport.classList.add('dragging');
        viewport.setPointerCapture?.(e.pointerId);
      };
      const onMove = (e: PointerEvent) => {
        if (!isDown) return;
        const dx = e.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));
        pos = wrapPos(startPos + dx);
        apply();
        const now = performance.now();
        const dt = now - lastT;
        if (dt > 0) velocity = (e.clientX - lastX) / dt; // px/ms
        lastX = e.clientX; lastT = now;
      };
      const onUp = (e: PointerEvent) => {
        if (!isDown) return;
        isDown = false;
        viewport.classList.remove('dragging');
        viewport.releasePointerCapture?.(e.pointerId);
        if (moved > 6) suppressClick = true; // 拖拽过则不触发卡片链接跳转
        const step = () => {
          if (isDown) { momentumId = 0; return; }
          if (Math.abs(velocity) < 0.02) { momentumId = 0; return; }
          pos = wrapPos(pos + velocity * 16);
          apply();
          velocity *= 0.93;
          momentumId = requestAnimationFrame(step);
        };
        momentumId = requestAnimationFrame(step);
      };

      // 捕获阶段拦截点击：拖拽误触时阻止跳转到摄影页
      viewport.addEventListener('click', (e) => {
        if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; }
      }, true);

      // 鼠标滚轮 / 触控板横向滚动
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        stopMomentum();
        pos = wrapPos(pos - (e.deltaY + e.deltaX));
        apply();
      }, { passive: false });

      viewport.addEventListener('pointerdown', onDown);
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);

      apply();
    });
  }

  function withBaseSafe(p: string): string {
    const base = (document.querySelector('meta[name="base"]') as HTMLMetaElement)?.content || '';
    if (p.startsWith('http') || p.startsWith('//')) return p;
    if (p.startsWith('/')) return base.replace(/\/$/, '') + p;
    return base + p;
  }

  buildMarquee();
  document.addEventListener('astro:page-load', buildMarquee);
</script>
